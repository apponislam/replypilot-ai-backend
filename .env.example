# Environment
NODE_ENV=development
PORT=5057
IP=0.0.0.0
MONGODB_URL=mongodb+srv://<USERNAME>:<PASSWORD>@cluster0.mongodb.net/replypilot-ai?retryWrites=true&w=majority
BCRYPT_SALT_ROUNDS=12

# URLs
CLIENT_URL=http://localhost:3000
SERVER_URL=http://localhost:5057

# JWT
JWT_ACCESS_SECRET=<YOUR_ACCESS_SECRET>
JWT_ACCESS_EXPIRE=30d
JWT_REFRESH_SECRET=<YOUR_REFRESH_SECRET>
JWT_REFRESH_EXPIRE=365d
JWT_PASSWORD_RESET_SECRET=<YOUR_PASSWORD_RESET_SECRET>

# Resend (Email)
RESEND_API_KEY=<YOUR_RESEND_API_KEY>
RESEND_FROM_EMAIL=onboarding@resend.dev

# Initial Admin
INITIAL_ADMIN_NAME=<INITIAL_ADMIN_NAME>
INITIAL_ADMIN_EMAIL=<INITIAL_ADMIN_EMAIL>
INITIAL_ADMIN_PASSWORD=<INITIAL_ADMIN_PASSWORD>
INITIAL_ADMIN_PHONE=<INITIAL_ADMIN_PHONE>
